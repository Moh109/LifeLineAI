[Unit]
Description=Lifeline backend and dashboard
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=__APP_DIR__/backend
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
