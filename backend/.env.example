# Copy to .env and fill in. Anything left blank turns that feature off; the app still runs.

# --- Database (Tiger Data / Timescale Cloud) ---
# Tiger Data console -> your service -> Connect -> copy the connection string.
# It looks like: postgres://tsdbadmin:PASSWORD@xxxx.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifeline

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
INTAKE_AGENT_ID=
CALLBACK_AGENT_ID=
# ElevenLabs -> Phone numbers -> your imported Twilio number -> copy its ID (not the phone number itself)
ELEVENLABS_PHONE_NUMBER_ID=
# ElevenLabs -> Agents -> Settings -> Post-call webhook -> HMAC secret
ELEVENLABS_WEBHOOK_SECRET=
# true only if you enabled First message + Language overrides on the callback agent's Security tab
CALLBACK_ALLOW_OVERRIDES=false

# Shared secret the agent tools send in the X-Lifeline-Secret header. Make up a long random string.
TOOL_SECRET=

# --- Gemini (aistudio.google.com -> Get API key) ---
GEMINI_API_KEY=
# Optional: several keys, comma-separated, no spaces or quotes. Used in order; on a quota error (429)
# the next key is tried. If set, GEMINI_API_KEY above is ignored.
GEMINI_API_KEYS=
# Free tier = about 20 requests/day PER MODEL. If you see 429 RESOURCE_EXHAUSTED, switch to another model or enable billing.
# Flash-Lite answered in ~3s vs ~85s for Flash on Oct 10, same extraction quality.
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried with every key only after GEMINI_MODEL is out of quota on all of them
GEMINI_BACKUP_MODEL=gemini-3.5-flash

# --- Backboard (app.backboard.io -> Settings -> API keys) ---
BACKBOARD_API_KEY=
# Leave blank on first run: the app creates an assistant and prints its ID. Paste it here after.
BACKBOARD_ASSISTANT_ID=

# --- Geocoding ---
# Optional. Without it, the free OpenStreetMap geocoder is used (fine for a demo).
GOOGLE_MAPS_API_KEY=
# Must be a real contact (email or project URL). OpenStreetMap blocks example.com with 403 and nothing gets a pin.
GEOCODER_CONTACT_EMAIL=

# --- Server ---
PORT=8000
# Comma-separated origins allowed to call the API (only needed when the dashboard runs on another port in dev)
CORS_ORIGINS=http://localhost:5173
